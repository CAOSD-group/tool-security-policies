                }
            ],
            "io_k8s_api_core_v1_Service_spec_selector": [
                {
                    "io_k8s_api_core_v1_Service_spec_selector_KeyMap": "app",
                    "io_k8s_api_core_v1_Service_spec_selector_ValueMap": "helloworld"
                }
            ]
        }
    }
